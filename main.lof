\contentsline {figure}{\numberline {4.1}{\ignorespaces Diagrama da arquitetura Single Supervision.}}{20}{figure.caption.14}%
\contentsline {figure}{\numberline {4.2}{\ignorespaces Diagrama da arquitetura Dual Supervision.}}{21}{figure.caption.15}%
\contentsline {figure}{\numberline {4.3}{\ignorespaces Exemplos de zonas de \acrshort {roi} em fatias de \acrshort {ct} com artefatos metálicos. Em cada par, a imagem da esquerda mostra a Zona de Artefato ($\mathcal {R}_{art}$, sobreposição a vermelho) e a da direita a Zona Distante ($\mathcal {R}_{dist}$, sobreposição a verde). As fatias cobrem anatomias torácica (topo), abdominal (meio) e torácica com implante unilateral (base), ilustrando a variabilidade da extensão e forma da zona de artefato em função da localização e número de implantes metálicos.}}{26}{figure.caption.16}%
\addvspace {10\p@ }
\contentsline {figure}{\numberline {5.1}{\ignorespaces Distribuição de MS-SSIM entre pares correspondentes (\acrshort {ctmar} vs DL/Stroke, aprovados automaticamente). Acima: histograma com os percentis P1 e P5, mediana, média e limiar de 0.9. Abaixo: zoom do histograma para a região de maior interesse, com destaque para os pares com MS-SSIM inferior a 0.9, que foram sujeitos a revisão manual.}}{30}{figure.caption.18}%
\contentsline {figure}{\numberline {5.2}{\ignorespaces Distribuição de MS-SSIM entre pares correspondentes (\acrshort {ctmar} vs DL/Stroke, aprovados automaticamente). À esquerda: histograma com os percentis P1 e P5, mediana, média e limiar de 0.9. À direita: ECDF correspondente. Os pares com MS-SSIM inferior a 0.9 foram sujeitos a revisão manual.}}{31}{figure.caption.19}%
\contentsline {figure}{\numberline {5.3}{\ignorespaces Exemplos de pares correspondentes com valores de\acrshort {ms-ssim} (0.7597, 0.7694 e 0.7717, respetivamente) aprovados após revisão visual humana mesmo com pontuações baixas.}}{32}{figure.caption.20}%
\contentsline {figure}{\numberline {5.4}{\ignorespaces 3 pares reprovados após inspeção visual humana com valores de \acrshort {ms-ssim} (head\_1159: 0.4573, head\_369: 0.5652 e head\_763: 0.6009, respetivamente). As pontuações desses pares na similaridade de cosseno foram head\_1159: 0.9960, head\_369: 0.9952 e head\_763: 0.9951.}}{33}{figure.caption.21}%
\contentsline {figure}{\numberline {5.5}{\ignorespaces Distribuição dos valores de similaridade de cosseno para os pares inspecionados visualmente.}}{34}{figure.caption.22}%
\contentsline {figure}{\numberline {5.6}{\ignorespaces Distribuição dos valores de\acrshort {ms-ssim} para os pares inspecionados visualmente.}}{35}{figure.caption.23}%
\contentsline {figure}{\numberline {5.7}{\ignorespaces Distribuição dos \textit {scores} de similaridade de cosseno (DL vs Stroke EIT) para os pares sem correspondência aprovada em nenhum dos dois \textit {datasets} de origem (N=435). Histograma laranja mostra a distribuição das pontuações dos 435 pares reprovados no Stroke EIT Dataset. O histograma em azul, mostra a distribuição dos mesmos 435 pares reprovados no Deep Lesion Dataset.}}{36}{figure.caption.24}%
